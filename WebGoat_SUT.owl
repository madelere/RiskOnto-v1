@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix riskonto: <https://cs.unb.ca/ontologies/riskonto#> .
@prefix wg: <https://cs.unb.ca/ontologies/sut/webgoat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cs.unb.ca/ontologies/sut/webgoat> a owl:Ontology ;
    rdfs:label "WebGoat SUT Ontology — SUT-2B Population"^^xsd:string ;
    rdfs:comment "WebGoat System Under Test ontology populated from SUT-2A certified scanner evidence. 43 canonical security findings, 13 RiskOnto reasoning candidates. Generated: 2026-06-10. Global Ontology UNMODIFIED."^^xsd:string ;
    owl:imports <https://cs.unb.ca/ontologies/riskonto/2.4> ;
    owl:versionIRI <https://cs.unb.ca/ontologies/sut/webgoat/2.0> .

wg:App_WebGoat a owl:NamedIndividual,
        riskonto:SystemUnderTest ;
    rdfs:label "WebGoat Application (SUT-2B)"^^xsd:string ;
    riskonto:Source "https://github.com/WebGoat/WebGoat"^^xsd:string ;
    riskonto:defaultSeverity "High"^^xsd:string ;
    riskonto:description "OWASP WebGoat 2023.4 — deliberately insecure Spring Boot web application for security training. SUT-2B population from 5-scanner evidence: Semgrep, SonarQube Issues, SonarQube Hotspots, Snyk SCA, ZAP DAST."^^xsd:string ;
    wg:hasAsset wg:Asset_AdminInterface,
        wg:Asset_AuthService,
        wg:Asset_FileUpload,
        wg:Asset_LessonEngine,
        wg:Asset_LoginModule,
        wg:Asset_REST_API,
        wg:Asset_SessionMgr,
        wg:Asset_UserMgmt,
        wg:Asset_WebGoatApp,
        wg:Asset_WebGoatDB .

wg:affectsAsset a owl:ObjectProperty ;
    rdfs:label "CanonicalSecurityFinding affectsAsset Asset"^^xsd:string ;
    rdfs:domain wg:CanonicalSecurityFinding ;
    rdfs:range riskonto:Asset .

wg:canonicalFindingId a owl:DatatypeProperty ;
    rdfs:label "Canonical finding ID from SUT-2A normalization (CV-NNN)"^^xsd:string ;
    rdfs:range xsd:string .

wg:classification a owl:DatatypeProperty ;
    rdfs:label "Vulnerability classification (ExploitableVulnerability, DependencyWeakness, etc.)"^^xsd:string ;
    rdfs:range xsd:string .

wg:containsFinding a owl:ObjectProperty ;
    rdfs:label "EvidenceBundle containsFinding ScannerFinding"^^xsd:string ;
    rdfs:domain wg:EvidenceBundle ;
    rdfs:range riskonto:ScannerFinding .

wg:eligibleForReasoning a owl:DatatypeProperty ;
    rdfs:label "Whether this finding activates RiskOnto SWRL reasoning"^^xsd:string ;
    rdfs:range xsd:string .

wg:fromScanner a owl:DatatypeProperty ;
    rdfs:label "Scanner name that produced this finding"^^xsd:string ;
    rdfs:range xsd:string .

wg:hasAsset a owl:ObjectProperty ;
    rdfs:label "SystemUnderTest hasAsset Asset"^^xsd:string ;
    rdfs:domain riskonto:SystemUnderTest ;
    rdfs:range riskonto:Asset .

wg:hasThreatScenario a owl:ObjectProperty ;
    rdfs:label "CanonicalSecurityFinding hasThreatScenario ThreatScenario"^^xsd:string ;
    rdfs:domain wg:CanonicalSecurityFinding ;
    rdfs:range riskonto:ThreatScenario .

wg:rawFindingIds a owl:DatatypeProperty ;
    rdfs:label "Comma-separated list of raw finding IDs (SEM-NNN, SQI-NNN, etc.)"^^xsd:string ;
    rdfs:range xsd:string .

wg:sourceCount a owl:DatatypeProperty ;
    rdfs:label "Number of raw scanner findings supporting this canonical finding"^^xsd:string ;
    rdfs:range xsd:string .

wg:supportedBy a owl:ObjectProperty ;
    rdfs:label "CanonicalSecurityFinding supportedBy EvidenceBundle"^^xsd:string ;
    rdfs:domain wg:CanonicalSecurityFinding ;
    rdfs:range riskonto:EvidenceBundle .

wg:Asset_UserMgmt a owl:NamedIndividual,
        riskonto:WebApplication ;
    rdfs:label "WebGoat User Management"^^xsd:string ;
    riskonto:description "User registration, profile management, and account administration components."^^xsd:string .

