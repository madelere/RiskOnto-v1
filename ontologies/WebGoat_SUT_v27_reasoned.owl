###  https://cs.unb.ca/ontologies/sut/webgoat#App_WebGoat
wg:App_WebGoat rdf:type owl:NamedIndividual ,
                        riskonto:SystemUnderTest ;
               wg:hasAsset wg:Asset_AdminInterface ,
                           wg:Asset_AuthService ,
                           wg:Asset_FileUpload ,
                           wg:Asset_LessonEngine ,
                           wg:Asset_LoginModule ,
                           wg:Asset_REST_API ,
                           wg:Asset_SessionMgr ,
                           wg:Asset_UserMgmt ,
                           wg:Asset_WebGoatApp ,
                           wg:Asset_WebGoatDB ;
               rdfs:label "WebGoat Application (SUT-2B)" ;
               riskonto:Source "https://github.com/WebGoat/WebGoat" ;
               riskonto:defaultSeverity "High" ;
               riskonto:description "OWASP WebGoat 2023.4 — deliberately insecure Spring Boot web application for security training. SUT-2B population from 5-scanner evidence: Semgrep, SonarQube Issues, SonarQube Hotspots, Snyk SCA, ZAP DAST." .


###  https://cs.unb.ca/ontologies/sut/webgoat#Asset_AdminInterface
wg:Asset_AdminInterface rdf:type owl:NamedIndividual ,
                                 riskonto:WebApplication ;
                        riskonto:hasVulnerability riskonto:VulnProfile_Broken_Access_Control ,
                                                  riskonto:VulnProfile_Debug_Mode_Enabled ;
                        rdfs:label "WebGoat Admin Interface" ;
                        riskonto:description "Administrative endpoints and management interface (Spring Actuator + /WebGoat/server-info)." .


###  https://cs.unb.ca/ontologies/sut/webgoat#Asset_AuthService
wg:Asset_AuthService rdf:type owl:NamedIndividual ,
                              riskonto:AuthenticationServer ;
                     riskonto:hasVulnerability riskonto:VulnProfile_Account_Abuse ,
                                               riskonto:VulnProfile_Authentication_Bypass ,
                                               riskonto:VulnProfile_Broken_Access_Control ,
                                               riskonto:VulnProfile_Weak_Cryptography ,
