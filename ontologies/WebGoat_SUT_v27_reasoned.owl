@prefix : <https://cs.unb.ca/ontologies/sut/webgoat#> .
@prefix wg: <https://cs.unb.ca/ontologies/sut/webgoat#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix riskonto: <https://cs.unb.ca/ontologies/riskonto#> .
@base <https://cs.unb.ca/ontologies/sut/webgoat#> .

<https://cs.unb.ca/ontologies/sut/webgoat> rdf:type owl:Ontology ;
                                            owl:versionIRI <https://cs.unb.ca/ontologies/sut/webgoat/2.7> ;
                                            rdfs:comment "WebGoat SUT aligned to RiskOnto v2.5. 43/43 canonical findings reasoning-enabled via hasVulnerability hooks. SUT-2D.1 semantic binding cleanup applied. SI-12 subClassOf link: wg:CanonicalSecurityFinding subClassOf riskonto:CanonicalSecurityFinding. Generated: 2026-07-09. Global Ontology UNMODIFIED." ;
                                            rdfs:label "WebGoat SUT Ontology — Phase 3 Repairs v27" .

#################################################################
#    Annotation properties
#################################################################

###  https://cs.unb.ca/ontologies/riskonto#Source
riskonto:Source rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#criticalityValue
riskonto:criticalityValue rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#defaultSeverity
riskonto:defaultSeverity rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#description
riskonto:description rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#impact
riskonto:impact rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#likelihood
riskonto:likelihood rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#riskScoreValue
riskonto:riskScoreValue rdf:type owl:AnnotationProperty .


###  https://cs.unb.ca/ontologies/riskonto#severity
riskonto:severity rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://cs.unb.ca/ontologies/riskonto#activatesProfile
riskonto:activatesProfile rdf:type owl:ObjectProperty .


###  https://cs.unb.ca/ontologies/sut/webgoat#affectsAsset
wg:affectsAsset rdf:type owl:ObjectProperty ;
                rdfs:domain wg:CanonicalSecurityFinding ;
                rdfs:range riskonto:Asset ;
                rdfs:label "CanonicalSecurityFinding affectsAsset Asset" .


###  https://cs.unb.ca/ontologies/sut/webgoat#containsFinding
wg:containsFinding rdf:type owl:ObjectProperty ;
                   rdfs:domain wg:EvidenceBundle ;
                   rdfs:range riskonto:ScannerFinding ;
                   rdfs:label "EvidenceBundle containsFinding ScannerFinding" .


###  https://cs.unb.ca/ontologies/sut/webgoat#hasAsset
wg:hasAsset rdf:type owl:ObjectProperty ;
            rdfs:domain riskonto:SystemUnderTest ;
            rdfs:range riskonto:Asset ;
            rdfs:label "SystemUnderTest hasAsset Asset" .


###  https://cs.unb.ca/ontologies/sut/webgoat#hasThreatScenario
wg:hasThreatScenario rdf:type owl:ObjectProperty ;
                     rdfs:domain wg:CanonicalSecurityFinding ;
                     rdfs:range riskonto:ThreatScenario ;
                     rdfs:label "CanonicalSecurityFinding hasThreatScenario ThreatScenario" .


###  https://cs.unb.ca/ontologies/sut/webgoat#supportedBy
wg:supportedBy rdf:type owl:ObjectProperty ;
               rdfs:domain wg:CanonicalSecurityFinding ;
               rdfs:range riskonto:EvidenceBundle ;
               rdfs:label "CanonicalSecurityFinding supportedBy EvidenceBundle" .


#################################################################
#    Data properties
#################################################################

###  https://cs.unb.ca/ontologies/sut/webgoat#canonicalFindingId
wg:canonicalFindingId rdf:type owl:DatatypeProperty ;
                      rdfs:range xsd:string ;
                      rdfs:label "Canonical finding ID from SUT-2A normalization (CV-NNN)" .


###  https://cs.unb.ca/ontologies/sut/webgoat#classification
wg:classification rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string ;
                  rdfs:label "Vulnerability classification (ExploitableVulnerability, DependencyWeakness, etc.)" .


###  https://cs.unb.ca/ontologies/sut/webgoat#eligibleForReasoning
wg:eligibleForReasoning rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:string ;
                        rdfs:label "Whether this finding activates RiskOnto SWRL reasoning" .


###  https://cs.unb.ca/ontologies/sut/webgoat#fromScanner
wg:fromScanner rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "Scanner name that produced this finding" .


###  https://cs.unb.ca/ontologies/sut/webgoat#rawFindingIds
wg:rawFindingIds rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:label "Comma-separated list of raw finding IDs (SEM-NNN, SQI-NNN, etc.)" .


###  https://cs.unb.ca/ontologies/sut/webgoat#sourceCount
wg:sourceCount rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "Number of raw scanner findings supporting this canonical finding" .


#################################################################
#    Classes
#################################################################

###  https://cs.unb.ca/ontologies/sut/webgoat#CanonicalSecurityFinding
wg:CanonicalSecurityFinding rdf:type owl:Class .


###  https://cs.unb.ca/ontologies/sut/webgoat#EvidenceBundle
wg:EvidenceBundle rdf:type owl:Class ;
                  rdfs:subClassOf riskonto:Evidence ;
                  rdfs:label "Evidence Bundle — aggregated scanner evidence for a canonical finding" .


#################################################################
#    Individuals
#################################################################

