<?xml version="1.0"?>
<rdf:RDF xmlns="https://cs.unb.ca/ontologies/riskonto#"
     xml:base="https://cs.unb.ca/ontologies/riskonto"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="https://creativecommons.org/ns#"
     xmlns:ns1="http://creativecommons.org/ns#"
     xmlns:ns9="https://cs.unb.ca/ontologies/nist#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ns11="http://www.w3.org/2004/02/skos/core#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:audit="https://cs.unb.ca/ontologies/audit#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:ontology="http://omv.ontoware.org/2005/05/ontology#"
     xmlns:riskonto="https://cs.unb.ca/ontologies/riskonto#">
    <owl:Ontology rdf:about="https://cs.unb.ca/ontologies/riskonto">
        <owl:versionIRI rdf:resource="https://cs.unb.ca/ontologies/riskonto/1.0"/>
        <ns1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <ontology:hasLicense rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dc:creator>Michael Adekunle Adelere
Yasser Morgan
Luigi Benedicenti</dc:creator>
        <dc:date>2025-09-22</dc:date>
        <dc:description>An integrated cybersecurity ontology that connects NIST CSF subcategories to NIST SP 800-53 controls and MITRE D3FEND techniques. It includes tooling compliance, threat modeling, SWRL-driven inference, explainable AI recommendations, and quantified risk reasoning.</dc:description>
        <dc:publisher>University of New Brunswick</dc:publisher>
        <dc:title>RiskOnto for Risk Ontology</dc:title>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:license>https://creativecommons.org/licenses/by/4.0/</dcterms:license>
        <dcterms:rights>© 2025 RiskOnto authors (UNB &amp; collaborators). Licensed under CC BY 4.0.</dcterms:rights>
        <rdfs:comment>This ontology provides an end-to-end semantic framework for automated compliance monitoring, mitigation recommendation, and risk scoring in cybersecurity.</rdfs:comment>
        <rdfs:label>RiskOnto</rdfs:label>
        <owl:versionInfo>1.0 (NIST and D3fend)</owl:versionInfo>
    </owl:Ontology>
    


