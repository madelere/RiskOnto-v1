    <!-- http://www.co-ode.org/ontologies/ont.owl#nonCompliantWith -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#nonCompliantWith">
        <owl:inverseOf rdf:resource="https://cs.unb.ca/ontologies/riskonto#hasNonCompliance"/>
        <rdfs:domain rdf:resource="https://cs.unb.ca/ontologies/riskonto#NonCompliance"/>
        <rdfs:range rdf:resource="https://cs.unb.ca/ontologies/riskonto#SubCategory"/>
        <rdfs:comment>Description for nonCompliantWith. </rdfs:comment>
        <rdfs:label>nonCompliantWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#recommendedMitigation -->

    <owl:ObjectProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#recommendedMitigation">
