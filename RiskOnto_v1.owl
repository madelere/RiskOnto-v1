    <owl:AnnotationProperty rdf:about="https://cs.unb.ca/ontologies/riskonto#hasControl">
        <rdfs:range rdf:resource="https://cs.unb.ca/ontologies/riskonto#Control"/>
    </owl:AnnotationProperty>
    


