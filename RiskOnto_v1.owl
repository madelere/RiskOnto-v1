        <rdfs:domain rdf:resource="https://cs.unb.ca/ontologies/riskonto#Control"/>
        <rdfs:range rdf:resource="https://cs.unb.ca/ontologies/riskonto#SubCategory"/>
        <rdfs:comment>Description for recommendedMitigation. </rdfs:comment>
        <rdfs:label>recommendedMitigation</rdfs:label>
    </owl:ObjectProperty>
    


