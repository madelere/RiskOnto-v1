  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/d3fend#D3_WSAM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#D3FENDTechnique"/>
    <rdfs:label>Web Session Access Mediation</rdfs:label>
    <riskonto:description>Web session access mediation secures user sessions in web applications by employing robust authentication and integrity validation, along with adaptive threat mitigation techniques, to ensure that access to web resources is authorized and protected from session-related attacks.</riskonto:description>
    <rdfs:comment>Web session access mediation secures user sessions in web applications by employing robust authentication and integrity validation, along with adaptive threat mitigation techniques, to ensure that access to web resources is authorized and protected from session-related attacks.</rdfs:comment>
  </rdf:Description>
