  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-105">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Struts: Form Field Without Validator</rdfs:label>
    <rdfs:comment>The product has a form field that is not validated by a corresponding validation form, which can introduce other weaknesses related to insufficient input validation.</rdfs:comment>
    <riskonto:cweID>CWE-105</riskonto:cweID>
