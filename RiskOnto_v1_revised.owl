    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1011"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/d3fend#D3_NTSA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#D3FENDTechnique"/>
    <rdfs:label>Network Traffic Signature Analysis</rdfs:label>
    <riskonto:description>Analyzing network traffic and compares it to known signatures</riskonto:description>
    <rdfs:comment>Analyzing network traffic and compares it to known signatures</rdfs:comment>
