  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/d3fend#D3_PLA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#D3FENDTechnique"/>
    <rdfs:label>Process Lineage Analysis</rdfs:label>
    <riskonto:description>Identification of suspicious processes executing on an end-point device by examining the ancestry and siblings of a process, and the associated metadata of each node on the tree, such as process execution, duration, and order relative to siblings and ancestors.</riskonto:description>
    <rdfs:comment>Identification of suspicious processes executing on an end-point device by examining the ancestry and siblings of a process, and the associated metadata of each node on the tree, such as process execution, duration, and order relative to siblings and ancestors.</rdfs:comment>
  </rdf:Description>
