  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-384">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Session Fixation</rdfs:label>
    <rdfs:comment>Authenticating a user, or otherwise establishing a new user session, without invalidating any existing session identifier gives an attacker the opportunity to steal authenticated sessions.</rdfs:comment>
    <riskonto:cweID>CWE-384</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/384.html</riskonto:MITRE_URL>
    <riskonto:Status>Incomplete</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
