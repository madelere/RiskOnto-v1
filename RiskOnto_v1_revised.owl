  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Excessive_Data_Exposure_RT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#ReasoningTrace"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#MitigationExplanation"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#ComplianceExplanation"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskExplanation"/>
    <rdfs:label>Excessive Data Exposure Reasoning Trace</rdfs:label>
    <riskonto:traceText>Excessive Data Exposure → CWE-200 → T1005 → M1057 → File Analysis → PR.PS-03 → Protect</riskonto:traceText>
  </rdf:Description>
