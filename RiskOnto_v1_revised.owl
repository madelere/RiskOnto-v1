  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#UnsafeObjectDeserializationAgainstWebapplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#ThreatScenario"/>
    <rdfs:label>Unsafe Object Deserialization Against WebApplication</rdfs:label>
    <riskonto:hasVulnerability rdf:resource="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Unsafe_Object_Deserialization"/>
