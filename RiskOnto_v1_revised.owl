  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#T1432">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#AttackTechnique"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#MobileTechnique"/>
    <rdfs:label>Access Contact List</rdfs:label>
    <riskonto:description>An adversary could call standard operating system APIs from a malicious application to gather contact list (i.e., address book) data, or with escalated privileges could directly access files containing contact list data.</riskonto:description>
    <rdfs:comment>An adversary could call standard operating system APIs from a malicious application to gather contact list (i.e., address book) data, or with escalated privileges could directly access files containing contact list data.</rdfs:comment>
    <riskonto:techniqueID>T1432</riskonto:techniqueID>
    <riskonto:externalID>T1432</riskonto:externalID>
    <riskonto:platform>mobile</riskonto:platform>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#GV_RM_02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#NISTSubcategory"/>
    <rdfs:label>GV.RM-02</rdfs:label>
    <riskonto:description>Risk appetite and risk tolerance statements are established, communicated, and maintained</riskonto:description>
    <rdfs:comment>Risk appetite and risk tolerance statements are established, communicated, and maintained</rdfs:comment>
    <riskonto:subcategoryID>GV.RM-02</riskonto:subcategoryID>
