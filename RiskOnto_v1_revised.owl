  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#T1629">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#AttackTechnique"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#MobileTechnique"/>
    <rdfs:label>Impair Defenses</rdfs:label>
    <riskonto:description>Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may span both native defenses as well as supplemental capabilities installed by users or mobile endpoint administrators.</riskonto:description>
    <rdfs:comment>Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may span both native defenses as well as supplemental capabilities installed by users or mobile endpoint administrators.</rdfs:comment>
    <riskonto:techniqueID>T1629</riskonto:techniqueID>
    <riskonto:externalID>T1629</riskonto:externalID>
    <riskonto:platform>mobile</riskonto:platform>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1001"/>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1004"/>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1010"/>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1011"/>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1012"/>
  </rdf:Description>
