  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/d3fend#D3_TBA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#D3FENDTechnique"/>
    <rdfs:label>Token-based Authentication</rdfs:label>
    <riskonto:description>Token-based authentication is an authentication protocol where users verify their identity in exchange for a unique access token. Users can then access the website, application, or resource for the life of the token without having to re-enter their credentials.</riskonto:description>
    <rdfs:comment>Token-based authentication is an authentication protocol where users verify their identity in exchange for a unique access token. Users can then access the website, application, or resource for the life of the token without having to re-enter their credentials.</rdfs:comment>
  </rdf:Description>
