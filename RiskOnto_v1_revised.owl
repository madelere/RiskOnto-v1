    <riskonto:hasControl rdf:resource="https://cs.unb.ca/ontologies/riskonto#AC_6_10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_01442_T1189_M1021_enterprise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/mappings#Mapping"/>
    <mappings:fromTechnique rdf:resource="https://cs.unb.ca/ontologies/riskonto#T1189"/>
    <mappings:toMitigation rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1021"/>
