    <rdfs:label>Horizontal Privilege Escalation Against WebApplication</rdfs:label>
    <riskonto:hasVulnerability rdf:resource="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Horizontal_Privilege_Escalation"/>
    <riskonto:targetsAssetType rdf:resource="https://cs.unb.ca/ontologies/riskonto#WebApplication"/>
