  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Tool_Abuse_RS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RecommendationStatement"/>
    <rdfs:label>Tool Abuse Recommendation</rdfs:label>
