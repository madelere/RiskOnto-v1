  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Typosquatting_Dependency_RJ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskJustification"/>
    <rdfs:label>Typosquatting Dependency Risk Justification</rdfs:label>
    <riskonto:derivedFromCWE rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE-829"/>
    <riskonto:hasRootCause rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE-829"/>
