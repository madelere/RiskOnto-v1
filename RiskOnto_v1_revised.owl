  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#T0875">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#AttackTechnique"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#ICSTechnique"/>
    <rdfs:label>Change Program State</rdfs:label>
    <riskonto:description>Adversaries may attempt to change the state of the current program on a control device. Program state changes may be used to allow for another program to take over control or be loaded onto the device.</riskonto:description>
    <rdfs:comment>Adversaries may attempt to change the state of the current program on a control device. Program state changes may be used to allow for another program to take over control or be loaded onto the device.</rdfs:comment>
