  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-602">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Client-Side Enforcement of Server-Side Security</rdfs:label>
    <rdfs:comment>The product is composed of a server that relies on the client to implement a mechanism that is intended to protect the server.</rdfs:comment>
    <riskonto:cweID>CWE-602</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/602.html</riskonto:MITRE_URL>
