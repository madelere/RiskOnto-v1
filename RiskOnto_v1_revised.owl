  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Business_Logic_Abuse_RCE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
