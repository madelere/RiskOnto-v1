  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Hardcoded_Credentials_RS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
