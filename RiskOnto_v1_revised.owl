  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#GV_PO_02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#NISTSubcategory"/>
    <rdfs:label>GV.PO-02</rdfs:label>
    <riskonto:description>Policy for managing cybersecurity risks is reviewed, updated, communicated, and enforced to reflect changes in requirements, threats, technology, and organizational mission</riskonto:description>
    <rdfs:comment>Policy for managing cybersecurity risks is reviewed, updated, communicated, and enforced to reflect changes in requirements, threats, technology, and organizational mission</rdfs:comment>
