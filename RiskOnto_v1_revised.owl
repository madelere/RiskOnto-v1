  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-120">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Buffer Copy without Checking Size of Input ('Classic Buffer Overflow')</rdfs:label>
    <rdfs:comment>The product copies an input buffer to an output buffer without verifying that the size of the input buffer is less than the size of the output buffer.</rdfs:comment>
    <riskonto:cweID>CWE-120</riskonto:cweID>
