  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_00254_T0843_M0800_ics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/mappings#Mapping"/>
    <mappings:fromTechnique rdf:resource="https://cs.unb.ca/ontologies/riskonto#T0843"/>
    <mappings:toMitigation rdf:resource="https://cs.unb.ca/ontologies/riskonto#M0800"/>
