    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskAssessment"/>
    <rdfs:label>Insecure Deserialization Against Microservice Risk Assessment</rdfs:label>
    <riskonto:impact rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:impact>
    <riskonto:likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:likelihood>
