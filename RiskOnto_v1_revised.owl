  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-643">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Neutralization of Data within XPath Expressions ('XPath Injection')</rdfs:label>
    <rdfs:comment>The product uses external input to dynamically construct an XPath expression used to retrieve data from an XML database, but it does not neutralize or incorrectly neutralizes that input. This allows an attacker to control the structure of the query.</rdfs:comment>
    <riskonto:cweID>CWE-643</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/643.html</riskonto:MITRE_URL>
    <riskonto:Status>Incomplete</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
