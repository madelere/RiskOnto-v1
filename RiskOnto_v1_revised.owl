  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#T1467">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#AttackTechnique"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#MobileTechnique"/>
    <rdfs:label>Rogue Cellular Base Station</rdfs:label>
    <riskonto:description>An adversary could set up a rogue cellular base station and then use it to eavesdrop on or manipulate cellular device communication. A compromised cellular femtocell could be used to carry out this technique(Citation: Computerworld-Femtocell).</riskonto:description>
    <rdfs:comment>An adversary could set up a rogue cellular base station and then use it to eavesdrop on or manipulate cellular device communication. A compromised cellular femtocell could be used to carry out this technique(Citation: Computerworld-Femtocell).</rdfs:comment>
    <riskonto:techniqueID>T1467</riskonto:techniqueID>
    <riskonto:externalID>T1467</riskonto:externalID>
    <riskonto:platform>mobile</riskonto:platform>
    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1009"/>
  </rdf:Description>
