  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Absolute Path Traversal</rdfs:label>
    <rdfs:comment>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize absolute path sequences such as "/abs/path" that can resolve to a location that is outside of that directory.</rdfs:comment>
    <riskonto:cweID>CWE-36</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/36.html</riskonto:MITRE_URL>
    <riskonto:Status>Draft</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Deprecated_Algorithms_RT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
