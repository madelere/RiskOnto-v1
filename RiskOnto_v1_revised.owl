    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#T1430_001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#AttackTechnique"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#MobileTechnique"/>
    <rdfs:label>Remote Device Management Services</rdfs:label>
    <riskonto:description>An adversary may use access to cloud services (e.g. Google's Android Device Manager or Apple iCloud's Find my iPhone) or to an enterprise mobility management (EMM)/mobile device management (MDM) server console to track the location of mobile devices managed by the service.(Citation: Krebs-Location)</riskonto:description>
