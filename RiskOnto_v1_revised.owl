    <riskonto:hasControl rdf:resource="https://cs.unb.ca/ontologies/riskonto#SA_8_18"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#ExcessiveIamPermissionsAgainstIamsystem">
