  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Public_Storage_Exposure_RJ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
