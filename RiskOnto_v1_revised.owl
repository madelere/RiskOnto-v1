  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-362">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')</rdfs:label>
    <rdfs:comment>The product contains a concurrent code sequence that requires temporary, exclusive access to a shared resource, but a timing window exists in which the shared resource can be modified by another code sequence operating concurrently.</rdfs:comment>
    <riskonto:cweID>CWE-362</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/362.html</riskonto:MITRE_URL>
    <riskonto:Status>Draft</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
    <riskonto:defaultImpact rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</riskonto:defaultImpact>
    <riskonto:defaultLikelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</riskonto:defaultLikelihood>
    <riskonto:riskScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</riskonto:riskScore>
    <riskonto:riskCriticality>Critical</riskonto:riskCriticality>
