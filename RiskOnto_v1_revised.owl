  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-78">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')</rdfs:label>
    <rdfs:comment>The product constructs all or part of an OS command using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended OS command when it is sent to a downstream component.</rdfs:comment>
    <riskonto:cweID>CWE-78</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/78.html</riskonto:MITRE_URL>
    <riskonto:Status>Stable</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
    <riskonto:defaultImpact rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:defaultImpact>
    <riskonto:defaultLikelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:defaultLikelihood>
    <riskonto:riskScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</riskonto:riskScore>
    <riskonto:riskCriticality>Critical</riskonto:riskCriticality>
