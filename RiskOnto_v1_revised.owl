  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#ImproperAssetManagementAgainstMicroservice_RiskAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskAssessment"/>
    <rdfs:label>Improper Asset Management Against Microservice Risk Assessment</rdfs:label>
    <riskonto:impact rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</riskonto:impact>
    <riskonto:likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</riskonto:likelihood>
