  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnProfile_Open_Services_RS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RecommendationStatement"/>
    <rdfs:label>Open Services Recommendation</rdfs:label>
    <riskonto:hasRecommendedAction>Implement SP 800-53r5 controls addressing NIST CSF 2.0 functions: Detect, Identify, Protect, Recover, Respond. Apply 26 identified ATT&amp;CK mitigation(s) verified against 1 CWE weakness(es).</riskonto:hasRecommendedAction>
