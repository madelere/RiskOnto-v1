  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#M0809">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#Mitigation"/>
    <rdfs:label>Operational Information Confidentiality</rdfs:label>
    <riskonto:description>Deploy mechanisms to protect the confidentiality of information related to operational processes, facility locations, device configurations, programs, or databases that may have information that can be used to infer organizational trade-secrets, recipes, and other intellectual property (IP).</riskonto:description>
    <rdfs:comment>Deploy mechanisms to protect the confidentiality of information related to operational processes, facility locations, device configurations, programs, or databases that may have information that can be used to infer organizational trade-secrets, recipes, and other intellectual property (IP).</rdfs:comment>
    <riskonto:mitigationID>M0809</riskonto:mitigationID>
    <riskonto:externalID>M0809</riskonto:externalID>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#connectsTo">
