    <riskonto:confidenceScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</riskonto:confidenceScore>
    <riskonto:hasRiskLevel rdf:resource="https://cs.unb.ca/ontologies/riskonto#CriticalRisk"/>
