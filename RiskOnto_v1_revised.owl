  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_02359_T1563_002_M1047_enterprise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
