  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#MaliciousPackageAgainstContainerimage_RiskAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
