  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-924">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Enforcement of Message Integrity During Transmission in a Communication Channel</rdfs:label>
    <rdfs:comment>The product establishes a communication channel with an endpoint and receives a message from that endpoint, but it does not sufficiently ensure that the message was not modified during transmission.</rdfs:comment>
    <riskonto:cweID>CWE-924</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/924.html</riskonto:MITRE_URL>
    <riskonto:Status>Incomplete</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
  </rdf:Description>
