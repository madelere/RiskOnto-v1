  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_00546_T0888_M0930_ics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/mappings#Mapping"/>
    <mappings:fromTechnique rdf:resource="https://cs.unb.ca/ontologies/riskonto#T0888"/>
