    <riskonto:derivedFromFunction rdf:resource="https://cs.unb.ca/ontologies/riskonto#Protect"/>
    <riskonto:derivedFromFunction rdf:resource="https://cs.unb.ca/ontologies/riskonto#Detect"/>
    <riskonto:derivedFromFunction rdf:resource="https://cs.unb.ca/ontologies/riskonto#Respond"/>
