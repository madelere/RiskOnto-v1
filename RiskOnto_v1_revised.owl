  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-646">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Reliance on File Name or Extension of Externally-Supplied File</rdfs:label>
    <rdfs:comment>The product allows a file to be uploaded, but it relies on the file name or extension of the file to determine the appropriate behaviors. This could be used by attackers to cause the file to be misclassified and processed in a dangerous fashion.</rdfs:comment>
    <riskonto:cweID>CWE-646</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/646.html</riskonto:MITRE_URL>
    <riskonto:Status>Incomplete</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
  </rdf:Description>
