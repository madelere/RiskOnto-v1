  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/d3fend#D3_HR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#D3FENDTechnique"/>
    <rdfs:label>Host Reboot</rdfs:label>
    <riskonto:description>Initiating a host's reboot sequence to terminate all running processes.</riskonto:description>
    <rdfs:comment>Initiating a host's reboot sequence to terminate all running processes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-91">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>XML Injection (aka Blind XPath Injection)</rdfs:label>
    <rdfs:comment>The product does not properly neutralize special elements that are used in XML, allowing attackers to modify the syntax, content, or commands of the XML before it is processed by an end system.</rdfs:comment>
    <riskonto:cweID>CWE-91</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/91.html</riskonto:MITRE_URL>
    <riskonto:Status>Draft</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_00069_T0811_M1018_ics">
