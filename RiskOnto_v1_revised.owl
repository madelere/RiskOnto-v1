  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/mappings#map_02564_T1591_M1056_enterprise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/mappings#Mapping"/>
    <mappings:fromTechnique rdf:resource="https://cs.unb.ca/ontologies/riskonto#T1591"/>
