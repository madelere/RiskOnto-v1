  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-119">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Restriction of Operations within the Bounds of a Memory Buffer</rdfs:label>
    <rdfs:comment>The product performs operations on a memory buffer, but it reads from or writes to a memory location outside the buffer's intended boundary. This may result in read or write operations on unexpected memory locations that could be linked to other variables, data structures, or internal program data.</rdfs:comment>
    <riskonto:cweID>CWE-119</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/119.html</riskonto:MITRE_URL>
    <riskonto:Status>Stable</riskonto:Status>
    <riskonto:Source>MITRE CWE XML v4.20</riskonto:Source>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#GV_OV_03">
