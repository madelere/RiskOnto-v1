    <riskonto:defaultLikelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:defaultLikelihood>
    <riskonto:riskScore rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</riskonto:riskScore>
    <riskonto:riskCriticality>Critical</riskonto:riskCriticality>
