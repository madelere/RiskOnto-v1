  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-470">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Use of Externally-Controlled Input to Select Classes or Code ('Unsafe Reflection')</rdfs:label>
    <rdfs:comment>The product uses external input with reflection to select which classes or code to use, but it does not sufficiently prevent the input from selecting improper classes or code.</rdfs:comment>
    <riskonto:cweID>CWE-470</riskonto:cweID>
    <riskonto:MITRE_URL>https://cwe.mitre.org/data/definitions/470.html</riskonto:MITRE_URL>
    <riskonto:Status>Draft</riskonto:Status>
