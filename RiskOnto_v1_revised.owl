  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-786">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Access of Memory Location Before Start of Buffer</rdfs:label>
    <rdfs:comment>The product reads or writes to a buffer using an index or pointer that references a memory location prior to the beginning of the buffer.</rdfs:comment>
