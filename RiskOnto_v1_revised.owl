    <rdfs:label>GV.OV-03</rdfs:label>
    <riskonto:description>Organizational cybersecurity risk management performance is evaluated and reviewed for adjustments needed</riskonto:description>
    <rdfs:comment>Organizational cybersecurity risk management performance is evaluated and reviewed for adjustments needed</rdfs:comment>
