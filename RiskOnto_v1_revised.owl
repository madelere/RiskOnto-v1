  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#ID_RA_01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#NISTSubcategory"/>
    <rdfs:label>ID.RA-01</rdfs:label>
    <riskonto:description>Vulnerabilities in assets are identified, validated, and recorded</riskonto:description>
    <rdfs:comment>Vulnerabilities in assets are identified, validated, and recorded</rdfs:comment>
    <riskonto:subcategoryID>ID.RA-01</riskonto:subcategoryID>
    <riskonto:belongsToCategory rdf:resource="https://cs.unb.ca/ontologies/riskonto#Risk_Assessment"/>
