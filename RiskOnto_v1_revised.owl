  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-647">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Use of Non-Canonical URL Paths for Authorization Decisions</rdfs:label>
    <rdfs:comment>The product defines policy namespaces and makes authorization decisions based on the assumption that a URL is canonical. This can allow a non-canonical URL to bypass the authorization.</rdfs:comment>
    <riskonto:cweID>CWE-647</riskonto:cweID>
