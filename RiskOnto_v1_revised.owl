  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#VulnerableDependencyAgainstCiCdPipeline_RiskAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskAssessment"/>
    <rdfs:label>Vulnerable Dependency Against CI_CD_Pipeline Risk Assessment</rdfs:label>
    <riskonto:impact rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</riskonto:impact>
