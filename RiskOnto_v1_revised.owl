  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#AuthenticationBypassAgainstIamsystem_RiskAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#RiskAssessment"/>
    <rdfs:label>Authentication Bypass Against IAMSystem Risk Assessment</rdfs:label>
