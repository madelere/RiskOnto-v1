  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Neutralization of Argument Delimiters in a Command ('Argument Injection')</rdfs:label>
    <rdfs:comment>The product constructs a string for a command to be executed by a separate component in another control sphere, but it does not properly delimit the intended arguments, options, or switches within that command string.</rdfs:comment>
    <riskonto:cweID>CWE-88</riskonto:cweID>
