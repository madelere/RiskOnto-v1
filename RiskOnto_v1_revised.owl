  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-1326">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Missing Immutable Root of Trust in Hardware</rdfs:label>
    <rdfs:comment>A missing immutable root of trust in the hardware results in the ability to bypass secure boot or execute untrusted or adversarial boot code.</rdfs:comment>
    <riskonto:cweID>CWE-1326</riskonto:cweID>
