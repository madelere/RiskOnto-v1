    <riskonto:mitigatedBy rdf:resource="https://cs.unb.ca/ontologies/riskonto#M1060"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cs.unb.ca/ontologies/riskonto#CWE-90">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://cs.unb.ca/ontologies/riskonto#CWE"/>
    <rdfs:label>Improper Neutralization of Special Elements used in an LDAP Query ('LDAP Injection')</rdfs:label>
    <rdfs:comment>The product constructs all or part of an LDAP query using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended LDAP query when it is sent to a downstream component.</rdfs:comment>
    <riskonto:cweID>CWE-90</riskonto:cweID>
